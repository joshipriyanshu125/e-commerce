# Existing application configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce
JWT_SECRET=replace-with-a-long-random-secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay test credentials from Dashboard -> Account & Settings -> API Keys.
# Keep the secret server-side only; never add it to the frontend.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_CURRENCY=INR

# Set this independently in Dashboard -> Webhooks. Required for /api/payments/webhook.
RAZORPAY_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Email delivery. For Gmail, create an App Password and use smtp.gmail.com:587.
# Do not use your normal Gmail password. SMTP_FROM must be a verified sender for
# your provider (and is usually the same address as SMTP_MAIL).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_MAIL=your-sending-address@example.com
SMTP_PASSWORD=your-provider-app-password
SMTP_FROM="Atelier <your-sending-address@example.com>"
STORE_NAME=Atelier
FRONTEND_URL=http://localhost:5173

# Browser push notifications. Generate a matching VAPID key pair with
# `npx web-push generate-vapid-keys`; the public key must also be used by the frontend.
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
